# Environment variables for Turnos Odontología
# Copy this file to .env and update values as needed

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/turnos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=turnos

# JWT
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173

# Application
ENV=development
TIMEZONE_CLINICA=America/Argentina/Buenos_Aires

# Redis (declared but not used in MVP per DD-06)
REDIS_URL=redis://redis:6379/0

# Frontend (build args)
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE=/api/v1
